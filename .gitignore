__pycache__/
*.pyc
*.py[cod]
*.egg-info/
.venv/

# Wegwerfbares: Vorschaubilder, Fingerabdrücke, Probeläufe
zwischenspeicher/
*.db
*.db-wal
*.db-shm
probe/

# Was hier auf keinen Fall hineingehört
#
# rclone.conf enthält Zugangsdaten zu allen eingerichteten Wolken - im
# Klartext oder mit einem Kennwort verschleiert, das ebenfalls in der
# Datei stehen kann.
rclone.conf

# Takeout-Archive sind der Bildbestand selbst.
#
# **Die Muster müssen zu Googles echten Namen passen.** Hier stand
# zuerst `*.takeout.zip` - das trifft nichts: Google liefert
# `takeout-20260905T084500Z-001.zip`. Ein Ausschlussmuster, das nichts
# ausschließt, ist schlimmer als keines, weil man sich darauf verlässt.
takeout-*.zip
takeout*/
Takeout/
*.takeout.zip

# Pakete
build/
dist/
*.deb
*.AppImage

# Pakete, die beim Bauen entstehen
verpacken/**/*.pkg.tar.zst
verpacken/**/src/
verpacken/**/pkg/
# Das Quellarchiv, das makepkg für das AUR-Paket herunterlädt. Fünf
# Megabyte, die sich jederzeit wiederherstellen lassen - und beim
# nächsten Nachziehen läge ohnehin das falsche da.
verpacken/**/*.tar.gz
# Der Bauordner des .deb - er entsteht bei jedem Lauf neu.
verpacken/debian/bau/

# Sicherung der Historie, die werkzeuge/historie-bereinigen.sh anlegt.
# Nach einem geglückten Lauf von Hand löschen.
.git-sicherung/
